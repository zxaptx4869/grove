{
  "expo": {
    "name": "知林 Grove",
    "slug": "grove-mobile",
    "scheme": "grove",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "知林 Grove 需要访问相册，把你选中的照片作为采集材料上传。",
          "cameraPermission": "知林 Grove 需要使用相机，把拍下的照片作为采集材料上传。",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.zxaptx4869.grove",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#F7F8F7"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d4fc4cf-db29-4af2-9169-2c2b35b6b1d4"
      }
    },
    "owner": "sherry4869"
  }
}
