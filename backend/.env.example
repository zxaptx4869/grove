# ===== Grove 后端环境变量模板 =====
# 复制为 backend/.env 后按需修改；.env 不提交到仓库。

# 数据库连接串：开发默认 SQLite；生产切换 MySQL 8，例如：
# mysql+asyncmy://user:password@127.0.0.1:3306/grove?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./grove.db

# 允许跨域的前端来源（逗号分隔）
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081

# 项目上下文生成器：llm（默认，无密钥时离线回退）/ demo（确定性）
CONTEXT_GENERATOR=llm

# 项目上下文刷新防抖时长（秒）
CONTEXT_REFRESH_DEBOUNCE_SECONDS=60

# 项目上下文最小生成间隔（秒）
CONTEXT_MIN_INTERVAL_SECONDS=300

# 进程内项目上下文 Worker（测试环境可置 false）
CONTEXT_WORKER_ENABLED=true

# 进程内目录起草 Worker（测试环境可置 false）
DIRECTORY_DRAFT_WORKER_ENABLED=true

# 进程内知识 Agent Worker（测试环境可置 false）
KNOWLEDGE_AGENT_WORKER_ENABLED=true

# 知识 Agent 固定执行图预算：召回上限 / 回答上下文 Entry 上限 / Evidence 读取上限
KNOWLEDGE_AGENT_RECALL_LIMIT=20
KNOWLEDGE_AGENT_CONTEXT_LIMIT=15
KNOWLEDGE_AGENT_EVIDENCE_LIMIT=30

# 连续追问上下文决策预算：最多使用的近期消息条数 / 单条历史消息截断长度
KNOWLEDGE_AGENT_HISTORY_LIMIT=8
KNOWLEDGE_AGENT_HISTORY_MESSAGE_CHARS=500

# 本地附件存储目录（相对 backend 运行目录；图片采集后保存在这里）
ATTACHMENT_DIR=uploads

# 模型密钥存储：keychain（默认）/ memory（仅测试）
SECRET_STORE=keychain

# 文本模型（产品不提供密钥，用户在设置页 BYOK 配置）
TEXT_PROVIDER=deepseek
TEXT_MODEL=deepseek-chat

# 视觉模型（产品不提供密钥，用户在设置页 BYOK 配置）
VISION_PROVIDER=doubao
VISION_MODEL=doubao-seed-2-0-lite-260428
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- 会话与认证占位键 ----
AUTH_SECRET_KEY=

# 会话 Cookie：生产环境（HTTPS）置 True
COOKIE_SECURE=false
