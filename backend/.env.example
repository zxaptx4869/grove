# ===== Grove 后端环境变量模板 =====
# 复制为 backend/.env 后按需修改；.env 不提交到仓库。

# 数据库连接串：开发默认 SQLite；生产切换 MySQL 8，例如：
# mysql+asyncmy://user:password@127.0.0.1:3306/grove?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./grove.db

# 允许跨域的前端来源（逗号分隔）
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI 供应商：demo（默认）/ deepseek / doubao
AI_PROVIDER=demo

# 项目上下文生成器：demo（默认）/ 其他占位
CONTEXT_GENERATOR=demo

# 项目上下文刷新防抖时长（秒）
CONTEXT_REFRESH_DEBOUNCE_SECONDS=1

# 进程内项目上下文 Worker（测试环境可置 false）
CONTEXT_WORKER_ENABLED=true

# 本地附件存储目录（相对 backend 运行目录；图片采集后保存在这里）
ATTACHMENT_DIR=uploads

# ---- 以下为占位键，真实接入时填充；本骨架阶段不连接任何外部服务 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
AUTH_SECRET_KEY=

# 会话 Cookie：生产环境（HTTPS）置 True
COOKIE_SECURE=false
